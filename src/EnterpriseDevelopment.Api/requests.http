### Добавление нового ресторана
POST https://localhost:7008/api/restaurants
Content-Type: application/json

{
  "name": "Новый ресторан",
  "address": "Самара, улица Гагарина, 10",
  "rating": 4.8,
  "openingTime": "09:00:00",
  "closingTime": "23:00:00"
}

### Добавление нового клиента
POST https://localhost:7008/api/clients
Content-Type: application/json

{
  "fullName": "Петрова Анна Сергеевна",
  "phoneNumber": "+79991234567",
  "deliveryAddress": "Самара, улица Победы, 20"
}

### Добавление новой категории
POST https://localhost:7008/api/categories
Content-Type: application/json

{
  "name": "Завтраки"
}

### Добавление нового блюда
POST https://localhost:7008/api/dishes
Content-Type: application/json

{
  "name": "Сырная пицца",
  "weight": 450,
  "price": 650,
  "categoryId": 1,
  "restaurantId": 1
}

### Добавление нового заказа
POST https://localhost:7008/api/orders
Content-Type: application/json

{
  "clientId": 1,
  "restaurantId": 1,
  "dishIds": [1, 2],
  "createdAt": "2026-10-29T12:00:00+04:00",
  "deliveredAt": "2026-10-29T12:35:00+04:00"
}

### Изменение ресторана
PUT https://localhost:7008/api/restaurants/1
Content-Type: application/json

{
  "name": "Сицилия Обновлённая",
  "address": "Самара, улица Ленина, 25",
  "rating": 5.0,
  "openingTime": "10:00:00",
  "closingTime": "22:00:00"
}

### Изменение клиента
PUT https://localhost:7008/api/clients/1
Content-Type: application/json

{
  "fullName": "Иванов Иван Сергеевич",
  "phoneNumber": "+79998887766",
  "deliveryAddress": "Самара, улица Молодогвардейская, 50"
}

### Изменение категории
PUT https://localhost:7008/api/categories/1
Content-Type: application/json

{
  "name": "Пицца и выпечка"
}

### Изменение блюда
PUT https://localhost:7008/api/dishes/1
Content-Type: application/json

{
  "name": "Пепперони с двойным сыром",
  "weight": 550,
  "price": 750,
  "categoryId": 1,
  "restaurantId": 1
}

### Изменение заказа
PUT https://localhost:7008/api/orders/1
Content-Type: application/json

{
  "clientId": 1,
  "restaurantId": 1,
  "dishIds": [1, 2],
  "createdAt": "2026-10-29T14:00:00+04:00",
  "deliveredAt": "2026-10-29T14:50:00+04:00"
}

### Удаление ресторана со связанными блюдами
DELETE https://localhost:7008/api/restaurants/1

### Удаление ресторана без связанных записей
DELETE https://localhost:7008/api/restaurants/11

### Удаление клиента с существующими заказами
DELETE https://localhost:7008/api/clients/1

### Удаление клиента без заказов
DELETE https://localhost:7008/api/clients/11

### Удаление категории со связанными блюдами
DELETE https://localhost:7008/api/categories/1

### Удаление категории без связанных блюд
DELETE https://localhost:7008/api/categories/11

### Удаление блюда, которое используется в заказах
DELETE https://localhost:7008/api/dishes/1

### Удаление блюда без связанных заказов
DELETE https://localhost:7008/api/dishes/13

### Удаление заказа
DELETE https://localhost:7008/api/orders/1
